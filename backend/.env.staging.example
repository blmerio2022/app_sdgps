# ============================================
# MODÈLE de l'environnement de STAGING — fichier VERSIONNÉ, sans aucun secret.
#
# Copier en `.env.staging` (gitignoré) puis renseigner les valeurs réelles :
#     cp .env.staging.example .env.staging
#
# ⚠️ Ce fichier ne sert QU'au banc d'essai local :
#     ENVIRONMENT=staging docker compose --profile postgres up
#    Le staging Railway, lui, est piloté par les **variables de service Railway** —
#    il ne lit aucun fichier `.env`. Toute variable ajoutée ici doit donc être
#    ajoutée AUSSI dans Railway (cf. docs/stockage-objet-scaleway.md).
# ============================================

# --- SendGrid (emails) ---
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@ancfcc.gov.ma
FROM_NAME=APP_SDGPS

# --- Environnement ---
ENVIRONMENT=staging
SHOW_TEST_DATA=true

# --- Base de données PostgreSQL ---
POSTGRES_DB=sdgps_staging
POSTGRES_USER=sdgps_staging
POSTGRES_PASSWORD=
# Dans docker-compose, l'hôte est le service `db` (surchargé par compose).
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Mots de passe d'amorçage (vides = mot de passe aléatoire par compte) ---
SUPER_ADMIN_PASSWORD=
APP_ADMIN_PASSWORD=
ORGADMIN_PASSWORD=
SEED_DEFAULT_PASSWORD=

# --- Amorçage ---
SEED_INITIAL_DATA=1

# ============================================
# STOCKAGE OBJET S3-COMPATIBLE (Scaleway / OVH / MinIO / AWS)
# ============================================
# Interrupteur : la SEULE présence de `AWS_STORAGE_BUCKET_NAME` fait basculer Django du
# disque local vers le stockage objet (cf. `backend/settings.py`). Laisser vide = disque
# local (volume persistant), comportement historique.
#
# Les variables gardent le préfixe `AWS_` car elles sont celles de `django-storages` ;
# elles n'impliquent AUCUNEMENT Amazon. C'est `AWS_S3_ENDPOINT_URL` qui désigne le
# fournisseur réel — sans lui, boto3 irait chez AWS.
#
# Valeurs pour Scaleway Paris (fournisseur retenu) :
#   AWS_S3_REGION_NAME=fr-par
#   AWS_S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
# Autres fournisseurs : OVH → https://s3.gra.io.cloud.ovh.net (région `gra`) ;
#   MinIO auto-hébergé → http(s)://<hote>:9000 ; AWS → laisser l'endpoint VIDE.

# Nom du bucket. VIDE = stockage disque local.
AWS_STORAGE_BUCKET_NAME=
# Clés d'API du fournisseur — SECRETS, ne jamais versionner.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Région du bucket.
AWS_S3_REGION_NAME=fr-par
# Endpoint du fournisseur (obligatoire hors AWS).
AWS_S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
# Domaine personnalisé / CDN servant les objets (optionnel).
AWS_S3_CUSTOM_DOMAIN=
# Durée de validité des URL signées, en secondes (défaut 3600).
# Les objets restent PRIVÉS : chaque lien est signé et expire.
AWS_QUERYSTRING_EXPIRE=3600

# --- Ports hôte (banc d'essai local) ---
BACKEND_PORT=8086
FRONTEND_PORT=4206

# --- CORS ---
CORS_ALLOWED_ORIGINS=

# --- Projet compose dédié → coexistence des environnements ---
COMPOSE_PROJECT_NAME=sdgps-staging
